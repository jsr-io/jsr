{
  "db_name": "PostgreSQL",
  "query": "SELECT\n          ticket_events.id, ticket_events.ticket_id, ticket_events.actor, ticket_events.kind as \"kind: TicketEventKind\", ticket_events.status as \"status: TicketStatus\", ticket_events.created_at,\n          users.id as \"user_id\", users.name as \"user_name\", users.avatar_url as \"user_avatar_url\", users.github_id as \"user_github_id\", users.gitlab_id as \"user_gitlab_id\", users.updated_at as \"user_updated_at\", users.created_at as \"user_created_at\"\n        FROM\n          ticket_events\n        INNER JOIN\n          users ON ticket_events.actor = users.id\n        WHERE\n          ticket_events.ticket_id = $1\n        ORDER BY ticket_events.created_at ASC;\n        ",
