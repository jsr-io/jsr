variable "gcp_project" {
  type = string
}

variable "domain_name" {
  type = string
}

variable "api_image_id" {
  description = "the Docker image ID for the API service"
  type        = string
}

variable "github_client_id" {
  type = string
}

variable "github_client_secret" {
  type      = string
  sensitive = true
}

variable "gitlab_client_id" {
  type = string
}

variable "gitlab_client_secret" {
  type      = string
  sensitive = true
}

variable "postmark_token" {
  type      = string
  sensitive = true
}

variable "postmark_webhook_password" {
  type      = string
  sensitive = true
}

variable "email_from_name" {
  type = string
}

variable "algolia_app_id" {
  type = string
}

# Admin API key used to configure the Algolia provider (manages indices and
# derives the scoped write/search keys). The scoped keys the app actually uses
# are generated by Terraform — see algolia.tf.
variable "algolia_admin_api_key" {
  type      = string
  sensitive = true
}

variable "production" {
  type    = bool
  default = false
}

variable "cloudflare_api_token" {
  type      = string
  sensitive = true
}

variable "cloudflare_account_id" {
  type = string
}

variable "cloudflare_zone_id" {
  type = string
}

variable "cloudflare_custom_firewall_ruleset_id" {
  description = "ID of the zone's existing http_request_firewall_custom entrypoint ruleset, imported into cloudflare_ruleset.custom_firewall. Only used in production."
  type        = string
  default     = ""
}

variable "cloudflare_ratelimit_ruleset_id" {
  description = "ID of the zone's existing http_ratelimit entrypoint ruleset, imported into cloudflare_ruleset.ratelimit. Only used in production."
  type        = string
  default     = ""

  validation {
    condition     = can(regex("^([0-9a-f]{32})?$", var.cloudflare_ratelimit_ruleset_id))
    error_message = "cloudflare_ratelimit_ruleset_id must be a ruleset ID (32 hex digits)."
  }
}

# OTLP/HTTP telemetry export (wired into the API Cloud Run services). Leave empty
# to disable; set both to point traces and logs at an OTLP/HTTP backend such as
# Grafana Cloud.
variable "otlp_endpoint" {
  description = "Base OTLP/HTTP endpoint, no per-signal path (e.g. Grafana Cloud's https://otlp-gateway-<zone>.grafana.net/otlp). The API appends the signal path itself (/v1/traces for spans, /v1/logs for logs). Empty disables export."
  type        = string
  default     = ""
}

variable "otlp_headers" {
  description = "Headers sent with every OTLP request, OTEL `key=value,key2=value2` format, carrying the backend auth (e.g. `Authorization=Basic <base64>` for Grafana Cloud)."
  type        = string
  default     = ""
  sensitive   = true
}

variable "e2e_bypass_token" {
  description = "Value of the `x-jsr-e2e` header that exempts the post-deploy e2e tests from the website bot rules. Empty disables the exemption."
  type        = string
  default     = ""
  sensitive   = true

  validation {
    condition     = can(regex("^[A-Za-z0-9]*$", var.e2e_bypass_token))
    error_message = "e2e_bypass_token may only contain letters and digits."
  }
}
