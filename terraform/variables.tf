variable "gcp_project" {
  type = string
}

variable "domain_name" {
  type = string
}

variable "github_client_id" {
  type = string
}

variable "github_client_secret" {
  type      = string
  sensitive = true
}

variable "gitlab_client_id" {
  type = string
}

variable "gitlab_client_secret" {
  type      = string
  sensitive = true
}

variable "postmark_token" {
  type      = string
  sensitive = true
}

variable "email_from_name" {
  type = string
}

variable "algolia_app_id" {
  type = string
}

# Admin API key used to configure the Algolia provider (manages indices and
# derives the scoped write/search keys). The scoped keys the app actually uses
# are generated by Terraform — see algolia.tf.
variable "algolia_admin_api_key" {
  type      = string
  sensitive = true
}

variable "production" {
  type    = bool
  default = false
}

variable "cloudflare_api_token" {
  type      = string
  sensitive = true
}

variable "cloudflare_account_id" {
  type = string
}

variable "cloudflare_zone_id" {
  type = string
}
